# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE=replace-with-supabase-service-role-key
SUPABASE_KEY=optional-anon-key-for-local-only
SUPABASE_JWT_SECRET=your-jwt-secret

# Backend Configuration
PORT=3000
NODE_ENV=production
JWT_SECRET=replace-with-32-byte-random-secret
JSON_BODY_LIMIT=256kb
JWT_EXPIRES_IN=30d
PAIRING_CODE_TTL_MS=600000
SYNC_DATA_MAX_BYTES=65536
EVENT_DATA_MAX_BYTES=16384
GOG_BIN=gog
GOG_ACCOUNT=brandontorres.dev@gmail.com

# CORS
CORS_ORIGIN=https://your-web-domain.com,tauri://localhost,http://localhost:1420

# AI Provider
AI_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_SITE_URL=https://danbron.local
OPENROUTER_APP_NAME=Danbron
ANTHROPIC_API_KEY=your-anthropic-api-key
AI_MODEL_GROQ=openai/gpt-oss-120b
AI_MODEL_OPENROUTER=openai/gpt-oss-120b:free
AI_MODEL_ANTHROPIC=claude-sonnet-4-20250514
AI_TRANSCRIBE_MODEL=whisper-large-v3
AI_MAX_TOKENS=800
AI_TEMPERATURE=0.3
